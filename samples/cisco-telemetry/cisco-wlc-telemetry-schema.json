{
  "title": "Cisco Catalyst WLC - Wireless Operational Telemetry Schema",
  "description": "Reference for the model-driven telemetry (MDT) that a Cisco Catalyst 9800 / IOS-XE wireless LAN controller streams for the subscriptions used in this integration. It documents the exact message structure, YANG paths, key fields, and value types your controller emits, so you can review the data your WLC sends.",
  "ciscoRelease": "IOS-XE 17.14 wireless operational YANG (Cisco-IOS-XE-wireless-{client,rrm,rogue,location}-oper)",
  "transport": {
    "mechanism": "Model-Driven Telemetry (MDT) dial-out over gRPC",
    "direction": "The WLC dials out over TCP and streams telemetry to the configured receiver; each message is acknowledged.",
    "wireFormat": "GPB self-describing key-value (GPB-KV). The JSON below is the decoded representation of that wire format.",
    "subscriptionConfig": "Each 'encodingPath' is a standard Cisco IOS-XE YANG operational path, configured as a telemetry subscription on the WLC."
  },
  "envelope": {
    "nodeIdStr": "Identifier of the reporting WLC",
    "subscriptionIdStr": "Telemetry subscription id configured on the WLC",
    "encodingPath": "YANG path of the data being streamed",
    "collectionId / collectionStartTime / msgTimestamp / collectionEndTime": "Collection identifiers and timestamps (epoch milliseconds, sent as strings)",
    "dataGpbkv[]": "The payload rows; each has a 'timestamp' and a 'fields' array",
    "fields[]": "Each field has a 'name' plus either a typed value OR a nested 'fields' array (for containers/lists)"
  },
  "valueTypeConventions": {
    "stringValue": "text / MAC address / timestamp / IP address / enumeration name",
    "uint32Value": "unsigned integer (channel, slot id, counts, levels)",
    "uint64Value": "large counters (bytes/packets); protobuf JSON may render 64-bit integers as strings",
    "sint32Value": "signed integer, e.g. RSSI in dBm (negative) and SNR in dB",
    "boolValue": "boolean flag",
    "nested fields[]": "a field carrying child 'fields' instead of a value is a YANG container or list"
  },
  "notes": [
    "Each example shows a representative subset of leaves; a live WLC may include additional leaves from the same YANG container.",
    "'keys' holds the list key leaf(s) that identify the row; 'content' holds the reported values.",
    "RSSI is signed (sint32Value, negative dBm); SNR is signed on most leaves, though some (e.g. most-recent-snr) are emitted as uint32Value."
  ],
  "subscriptions": [
    {
      "name": "Per-client statistics",
      "description": "Per associated wireless client: traffic counters plus the client's most recent RSSI and SNR.",
      "yangModule": "Cisco-IOS-XE-wireless-client-oper",
