                    "uint64Value": 1200
                  },
                  {
                    "name": "most-recent-rssi",
                    "sint32Value": -55
                  },
                  {
                    "name": "most-recent-snr",
                    "uint32Value": 34
                  },
                  {
                    "name": "speed",
                    "uint32Value": 866
                  },
                  {
                    "name": "spatial-stream",
                    "uint32Value": 2
                  },
                  {
