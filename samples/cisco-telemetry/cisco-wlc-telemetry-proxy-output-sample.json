    "outputExample": "aa:bb:cc:e7c7d3d170503d423d6323bf856c75ea7fad696f5aa846bddb50baea61a13824",
    "format": "<oui-byte-1>:<oui-byte-2>:<oui-byte-3>:<64-character-hmac-sha256>"
  },
